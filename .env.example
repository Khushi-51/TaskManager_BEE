# Example environment variables for local docker/development
# Replace placeholder values before running in production

# MongoDB - when using docker-compose, use mongodb://mongo:27017/taskManager
MONGODB_URI=mongodb://mongo:27017/taskManager

# Redis
REDIS_URL=redis://redis:6379

# JWT secret used for signing tokens
JWT_SECRET=change_this_to_a_strong_secret

# App port
PORT=3000

# Any other env vars used by your app (e.g., third-party API keys)
# THIRD_PARTY_KEY=...
